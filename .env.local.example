# Copy this file to .env.local and fill in your key.
#
# COI Hero calls the Anthropic API server-side to read each certificate PDF and
# pull out the structured fields. Get a key at https://console.anthropic.com/
# (Settings -> API Keys). Costs a few cents per certificate.
#
# Without a key, COI Hero still runs -- uploads are stored and you fill in the
# fields by hand on the review screen.

ANTHROPIC_API_KEY=

# Optional. Which model does the extraction. Default: claude-sonnet-5.
# Set to claude-opus-5 for maximum accuracy on messy / handwritten scans
# (~2.5x the cost per certificate).
COI_EXTRACT_MODEL=claude-sonnet-5

# Optional. Demo mode: with no API key, every upload gets realistic *mock*
# extracted fields (generated from the file name) so you can demo the full
# upload -> review -> table flow offline. Leave unset for normal use.
# COI_DEMO_MODE=1
